{
  "name": "ask-jdp",
  "version": "0.0.0",
  "description": "An evidence-bounded, privacy-conscious portfolio assistant.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jon-devlapaz/ask-jdp.git"
  },
  "bugs": {
    "url": "https://github.com/jon-devlapaz/ask-jdp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev-keychain.mjs",
    "dev:server": "vite dev",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "build": "npm run build:node && node scripts/prepare-sites-build.mjs",
    "build:node": "npm run build:server && npm run build:ui",
    "build:server": "vite build && node scripts/prepare-node-entry.mjs",
    "build:ui": "vite build --config vite.config.ui.ts",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "node scripts/live-eval-keychain.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "verify": "npm run check:types && npm test && npm run build && npm run test:sites"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/react": "2.0.3",
    "@flue/runtime": "2.0.3",
    "@flue/sdk": "2.0.3",
    "@hono/node-server": "2.1.0",
    "@phosphor-icons/react": "2.1.10",
    "border-beam": "1.3.0",
    "hono": "4.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "thinking-orbs": "0.2.0"
  },
  "devDependencies": {
    "@flue/vite": "2.0.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
