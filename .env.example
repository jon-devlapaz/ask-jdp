# Local development reads the API key from the configured macOS Keychain
# service; do not copy the secret into this file.
ASK_JDP_API_KEYCHAIN_SERVICE=ask-jdp-api-key
ASK_JDP_SESSION_KEYCHAIN_SERVICE=ask-jdp-session-secret
ASK_JDP_LOG_DIRECTORY=
SOCRATINK_BASE_URL=http://127.0.0.1:3001/v1
SOCRATINK_MODEL_ID=auto

# Production must provide stable, high-entropy secrets through its secret store.
SOCRATINK_API_KEY=
SESSION_SECRET=
PUBLIC_ORIGIN=
ASK_JDP_BIND_HOST=127.0.0.1
ASK_JDP_TRANSCRIPT_RETENTION_HOURS=18
TRUST_PROXY=false
